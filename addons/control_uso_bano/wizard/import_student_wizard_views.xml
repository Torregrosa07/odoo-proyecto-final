<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_import_student_wizard_form" model="ir.ui.view">
        <field name="name">import.student.wizard.form</field>
        <field name="model">import.student.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Alumnos desde CSV">
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <separator string="Formato esperado del CSV"/>
                <p>El archivo CSV debe usar <strong>punto y coma (;)</strong> como separador y contener las siguientes columnas:</p>
                <ul>
                    <li><strong>nombre</strong> (obligatorio): Nombre completo del alumno</li>
                    <li><strong>curso</strong> (obligatorio): Curso del alumno (ej: 1º ESO A)</li>
                    <li><strong>email</strong> (opcional): Email del alumno</li>
                    <li><strong>telefono</strong> (opcional): Teléfono de contacto</li>
                </ul>
                <footer>
                    <button name="action_import" string="Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_student_wizard" model="ir.actions.act_window">
        <field name="name">Importar Alumnos (CSV)</field>
        <field name="res_model">import.student.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
