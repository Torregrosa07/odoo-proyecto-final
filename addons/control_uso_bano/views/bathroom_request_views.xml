<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista listado (tree) de solicitudes con colores por estado -->
    <record id="view_bathroom_request_list" model="ir.ui.view">
        <field name="name">bathroom.request.list</field>
        <field name="model">bathroom.request</field>
        <field name="arch" type="xml">
            <!-- Decoraciones: rojo=retrasado, verde=devuelto, azul=activo -->
            <tree string="Solicitudes" decoration-danger="state == 'delayed'"
                                       decoration-success="state == 'returned'"
                                       decoration-info="state == 'active'">
                <field name="student_id"/>
                <field name="course"/>
                <field name="key_id"/>
                <field name="time_out"/>
                <field name="time_in"/>
                <field name="duration"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Vista formulario de solicitud con botones de acción -->
    <record id="view_bathroom_request_form" model="ir.ui.view">
        <field name="name">bathroom.request.form</field>
        <field name="model">bathroom.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de baño">
                <header>
                    <!-- Botón para registrar la entrega de la llave al alumno -->
                    <button name="action_deliver_key" string="Entregar llave"
                            type="object" class="btn-primary"
                            invisible="state != 'active'"/>
                    <!-- Botón para registrar la devolución de la llave -->
                    <button name="action_return_key" string="Devolver llave"
                            type="object" class="btn-success"
                            invisible="state != 'active'"/>
                    <!-- Barra de estado visual del flujo -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,returned,delayed"/>
                </header>
                <sheet>
                    <group string="Datos del alumno">
                        <field name="student_id"/>
                        <field name="course"/>
                        <field name="key_id"/>
                    </group>
                    <group string="Registro de tiempo">
                        <field name="time_out"/>
                        <field name="time_in"/>
                        <field name="duration"/>
                    </group>
                    <group string="Observaciones">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de búsqueda -->
    <record id="view_bathroom_request_search" model="ir.ui.view">
        <field name="name">bathroom.request.search</field>
        <field name="model">bathroom.request</field>
        <field name="arch" type="xml">
            <search string="Buscar solicitudes">
                <field name="student_id"/>
                <field name="course"/>
                <field name="key_id"/>
                <filter string="Activas" name="filter_active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Devueltas" name="filter_returned"
                        domain="[('state', '=', 'returned')]"/>
                <filter string="Retrasadas" name="filter_delayed"
                        domain="[('state', '=', 'delayed')]"/>
                <filter string="Hoy" name="filter_today"
                        domain="[('time_out', '&gt;=', (context_today()).strftime('%Y-%m-%d 00:00:00')),
                                 ('time_out', '&lt;=', (context_today()).strftime('%Y-%m-%d 23:59:59'))]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter string="Alumno" name="group_student" context="{'group_by': 'student_id'}"/>
                    <filter string="Curso" name="group_course" context="{'group_by': 'course'}"/>
                    <filter string="Llave" name="group_key" context="{'group_by': 'key_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by': 'time_out:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vista gráfica -->
    <record id="view_bathroom_request_graph" model="ir.ui.view">
        <field name="name">bathroom.request.graph</field>
        <field name="model">bathroom.request</field>
        <field name="arch" type="xml">
            <graph string="Uso del baño" type="bar">
                <field name="course"/>
                <field name="duration" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Vista pivot -->
    <record id="view_bathroom_request_pivot" model="ir.ui.view">
        <field name="name">bathroom.request.pivot</field>
        <field name="model">bathroom.request</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de uso">
                <field name="course" type="row"/>
                <field name="state" type="col"/>
                <field name="duration" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Acción principal -->
    <record id="action_bathroom_request" model="ir.actions.act_window">
        <field name="name">Solicitudes</field>
        <field name="res_model">bathroom.request</field>
        <field name="view_mode">tree,form,graph,pivot</field>
        <field name="search_view_id" ref="view_bathroom_request_search"/>
    </record>

</odoo>